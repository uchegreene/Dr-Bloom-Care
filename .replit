modules = ["nodejs-24", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "cloudrun"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
ADMIN_EMAILS = "drbloomcare.app@gmail.com"
SUPER_ADMIN_EMAIL = "drbloomcare.app@gmail.com"

[objectStorage]
defaultBucketID = "replit-objstore-6d48be61-8980-486b-b5bd-31aee6e8e054"
